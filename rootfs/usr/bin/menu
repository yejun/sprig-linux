#!/bin/sh
# menu: Sprig Linux's programs in a list (dialog, its colours in /etc/dialogrc). Tap one to start it (the console
# mouse; dialog-patches/0001), or choose it with the arrow keys and Enter; when it ends, the list comes back. The
# line at the bottom of the screen describes the highlighted one. Exit (or Esc) leaves the list.
#
# One program a line: the command | its name in the list | its description at the bottom. Commands not installed
# are left out; "off" is the list's own.
LIST='lynx|Web browser|Browse the web as text: pages, links and forms, with HTTPS
mc|Files|Midnight Commander: two panels of files to copy, move, view and edit
nano|Text editor|A simple text editor, with its commands listed along the bottom
htop|Processes|The programs running, and how much of the CPU and memory each uses
ncdu|Disk use|What fills the disk: folders sorted by size, to look into or delete
zork1|Zork I|The 1980 text adventure from Infocom: explore the Great Underground Empire
zork2|Zork II|The sequel (1981): the Wizard of Frobozz, deeper underground
zork3|Zork III|The end of the trilogy (1982): the Dungeon Master awaits
sqlite3|SQLite|An SQL database shell: tables in a file, or in memory
lua|Lua|The Lua language: type a line and it runs
micropython|MicroPython|Python 3 for small computers: type a line and it runs
ssh|Remote login|Log in to another computer over the network (asks for user@host)
off|Power off|Shut Linux down; then the PC switches off'

ver=$(. /etc/os-release 2>/dev/null && echo "$VERSION")

# a program, then the list again; if it failed, its last words stay on the screen until Enter
run() {
  "$@"
  s=$?
  if [ "$s" -ne 0 ]; then
    printf '\n%s ended (status %d). Press Enter for the list. ' "$1" "$s"
    read -r _
  fi
}

choice=lynx
while :; do
  set --
  n=0
  while IFS='|' read -r tag text hint; do
    case $tag in
      '') continue ;;
      off) ;;
      *) command -v "$tag" >/dev/null 2>&1 || continue ;;
    esac
    set -- "$@" "$tag" "$text" "$hint"
    n=$((n + 1))
  done <<EOF
$LIST
EOF
  choice=$(dialog --backtitle "Sprig Linux $ver" --title " Programs " --item-help --default-item "$choice" \
    --ok-label Start --cancel-label Exit \
    --menu "Tap one, or arrows and Enter. When it ends, this list comes back." 0 0 "$n" "$@" 3>&1 1>&2 2>&3) || break
  clear
  case $choice in
    off)
      dialog --title " Power off " --defaultno --yesno "Switch off now?\n\nLinux shuts down, then the PC switches off." 0 0 &&
        { clear; exec poweroff; } ;;
    ssh)
      dest=$(dialog --title " ssh " --inputbox "Log in to (user@host):" 8 50 3>&1 1>&2 2>&3) && [ -n "$dest" ] &&
        { clear; run ssh "$dest"; } ;;
    ncdu) run ncdu -x / ;;
    *) run "$choice" ;;
  esac
done
clear
