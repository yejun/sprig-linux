#!/bin/sh
# menu: Sprig Linux's programs in a list (dialog, its colours in /etc/dialogrc). Tap one to start it (the console
# mouse; dialog-patches/0001), or choose it with the arrow keys and Enter; when it ends, the list comes back. The
# line at the bottom of the screen says what the highlighted one is for and how to leave it. Esc (or Prompt) leaves
# the list.
#
# One program a line: the command | what it is | the hint at the bottom. Commands not installed are left out;
# "shell" and "off" are the list's own.
LIST='lynx|Web browser|Arrows move between links, Enter follows one, g opens an address, q quits
mc|Files (Midnight Commander)|Tab: the other panel; F5 copies, F6 moves, F8 deletes, F10 quits
nano|Text editor|Ctrl+O saves, Ctrl+R opens a file, Ctrl+X quits
htop|Processes and memory|Arrows choose a process, F9 ends it, q quits
ncdu|Disk use|Enter opens a folder, Left goes back, d deletes, q quits
zork1|Zork I: The Great Underground Empire|A text adventure: type what to do (open mailbox, go north); save, quit
zork2|Zork II: The Wizard of Frobozz|A text adventure: type what to do; save, restore, quit
zork3|Zork III: The Dungeon Master|A text adventure: type what to do; save, restore, quit
sqlite3|SQLite database|SQL ends with ;  .help lists the commands, .quit leaves (a database in memory)
lua|Lua|Type Lua to run it; Ctrl+D leaves
micropython|MicroPython|Type Python to run it; Ctrl+D leaves
ssh|Log in to another computer|Asks for user@host; exit there comes back here
shell|The command prompt|Leaves this list; type menu to come back
off|Power off|Linux shuts down, then the PC switches off'

ver=$(. /etc/os-release 2>/dev/null && echo "$VERSION")

# a program, then the list again; if it failed, its last words stay on the screen until Enter
run() {
  "$@"
  s=$?
  if [ "$s" -ne 0 ]; then
    printf '\n%s ended (status %d). Press Enter for the list. ' "$1" "$s"
    read -r _
  fi
}

choice=lynx
while :; do
  set --
  n=0
  while IFS='|' read -r tag text hint; do
    case $tag in
      '') continue ;;
      shell|off) ;;
      *) command -v "$tag" >/dev/null 2>&1 || continue ;;
    esac
    set -- "$@" "$tag" "$text" "$hint"
    n=$((n + 1))
  done <<EOF
$LIST
EOF
  choice=$(dialog --backtitle "Sprig Linux $ver" --title " Programs " --item-help --default-item "$choice" \
    --hline "Tap one, or arrows and Enter.  Esc: the prompt" --ok-label Start --cancel-label Prompt \
    --menu "Choose a program. When it ends, this list comes back." 0 0 "$n" "$@" 3>&1 1>&2 2>&3) || break
  clear
  case $choice in
    shell) break ;;
    off)
      dialog --title " Power off " --defaultno --yesno "Switch off now?\n\nLinux shuts down, then the PC switches off." 0 0 &&
        { clear; exec poweroff; } ;;
    ssh)
      dest=$(dialog --title " ssh " --inputbox "Log in to (user@host):" 8 50 3>&1 1>&2 2>&3) && [ -n "$dest" ] &&
        { clear; run ssh "$dest"; } ;;
    ncdu) run ncdu -x / ;;
    *) run "$choice" ;;
  esac
done
clear
