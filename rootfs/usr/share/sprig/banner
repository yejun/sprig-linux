# Sprig's card at the end of startup (sourced by /etc/init.d/rcS), at SSH logins (/etc/profile) and with
# "sh /usr/share/sprig/banner": the
# version, what the machine has and a few commands, beside a sprig. Shell built-ins but one df (a program started
# costs the guest ~170 ms). Colours and columns are ANSI codes, bold for the bright colours (the Linux console's
# way), which an SSH terminal shows the same. On the 100-column graphics console the card is 9 rows: printed after
# the kernel's messages and the startup steps, it scrolls exactly the penguin off the top.
E=$'\033'
N="$E[0m" G="$E[1;32m" g="$E[22;32m" Y="$E[1;33m" T="$E[22;33m" C="$E[22;36m" B="$E[1;36m" W="$E[1;37m"
w="$E[22;37m" D="$E[1;30m" R="$E[1;31m"

# the width: $COLUMNS (an SSH login's terminal: /etc/profile), else the console's, the frame buffer's at 8 pixels a
# character (80 on the text console)
cols=80
[ -r /sys/class/graphics/fb0/virtual_size ] && read -r vs < /sys/class/graphics/fb0/virtual_size && cols=$((${vs%,*} / 8))
case $COLUMNS in "" | *[!0-9]*) ;; *) [ "$COLUMNS" -ge 60 ] && cols=$COLUMNS ;; esac

ver=?
if [ -r /etc/os-release ]; then
  while IFS='=' read -r k v; do [ "$k" = VERSION ] && ver=${v#\"} && ver=${ver%\"}; done < /etc/os-release
fi
read -r kver < /proc/sys/kernel/osrelease
arch=
[ -r /proc/sys/kernel/arch ] && read -r arch < /proc/sys/kernel/arch
read -r host < /proc/sys/kernel/hostname
read -r up _ < /proc/uptime
up=${up%.*}
while read -r k v _; do
  case $k in
    MemTotal:) mt=$v ;; MemAvailable:) ma=$v ;; SwapTotal:) st=$v ;; SwapFree:) sf=$v ;;
  esac
done < /proc/meminfo
dt=0 du=0
df -k / > /tmp/.sprig-df 2>/dev/null && { read -r _; read -r _ dt du _; } < /tmp/.sprig-df
ip=
if [ -r /proc/net/fib_trie ]; then   # the address of an interface: a /32 host LOCAL entry, not 127.x
  a=
  while read -r x y _; do
    case $x in
      "|--") a=$y ;;
      /32) [ "$y" = host ] && case $a in 127.*) ;; *) ip=$a ;; esac ;;
    esac
  done < /proc/net/fib_trie
fi

mb() {   # mb <kB>: in MB, one decimal below 100 (and none for .0) -> $v
  v=$((($1 * 10 + 512) / 1024))
  if [ $v -ge 1000 ]; then v=$(((v + 5) / 10))
  elif [ $((v % 10)) -eq 0 ]; then v=$((v / 10))
  else v=$((v / 10)).$((v % 10))
  fi
}
bar() {   # bar <used> <total>: ten squares, the used part green, yellow from 60%, red from 85% -> $v
  n=0 c=$G v=
  if [ "$2" -gt 0 ]; then
    n=$((($1 * 10 + $2 / 2) / $2))
    p=$(($1 * 100 / $2))
    [ $p -ge 60 ] && c=$Y
    [ $p -ge 85 ] && c=$R
  fi
  v=$c i=0
  while [ $i -lt 10 ]; do
    [ $i -eq $n ] && v=$v$D
    v=$v■ i=$((i + 1))
  done
}
rule() {   # rule <n>: n horizontal lines -> $v
  v= i=$1
  while [ $i -gt 0 ]; do v=$v─ i=$((i - 1)); done
}
at() { printf '%s' "$E[$1G"; }   # to column $1 (from 1)

mb $((mt - ma)); mu=$v; mb $mt; mt_=$v
mb $((st - sf)); su=$v; mb $st; st_=$v
mb $du; du_=$v; mb $dt; dt_=$v
if [ -n "$sprig_startup" ]; then
  when="${C}Started" whenv="${w}in ${W}$up s"
else
  when="${C}Up" whenv="${W}$((up / 3600)) h $((up / 60 % 60)) min"
  [ $up -lt 3600 ] && whenv="${W}$((up / 60)) min"
fi
if [ -n "$ip" ]; then
  net="${W}$ip${w} on eth0"
elif [ -e /sys/class/net/eth0 ]; then
  net="${W}eth0${w}, address on its way"
else
  net="${w}none"
fi

# the sprig: half blocks for the leaves (two 8 x 8 pixels a character), a thin line for the stem
art0="       $G█  ▄▄█"
art1="  $G▄    $T│$G▄▀▀"
art2="  $G▀▀█▄ $T│"
art3="      $G▀$T│  $g▄▄█"
art4="  $g▄    $T│$g▄▀▀"
art5="  $g▀▀█▄ $T│"
art6="      $g▀$T│"

# the heading in the rule: "─── Sprig Linux 1.3.0 ── Linux 7.3.1 · i586 ───..." to the last column
n=$((cols - 4 - 12 - ${#ver} - 1 - 3 - 6 - ${#kver} - 1))
[ -n "$arch" ] && n=$((n - 3 - ${#arch}))
rule $n
printf '\n%s\n' "$D─── ${G}Sprig Linux $Y$ver $D── ${B}Linux $kver${arch:+$D · $w$arch} $D$v$N"
mem="${C}Memory"; swap="${C}Swap"; disk="${C}Disk"
if [ "$cols" -ge 100 ]; then
  bar $((mt - ma)) $mt; mbar=$v; bar $((st - sf)) $st; sbar=$v; bar $du $dt; dbar=$v
  printf '%s' "    $art0"; at 25; printf '%s' "${C}Host"; at 34; printf '%s' "$G$host"
  at 63; printf '%s' "$when"; at 72; printf '%s\n' "$whenv"
  printf '%s' "    $art1"; at 25; printf '%s' "$mem"; at 34; printf '%s' "$mbar  $W$mu ${w}of $mt_ MB"
  at 63; printf '%s' "$swap"; at 72; printf '%s\n' "$sbar  $W$su ${w}of $st_ MB"
  printf '%s' "    $art2"; at 25; printf '%s' "$disk"; at 34; printf '%s' "$dbar  $W$du_ ${w}of $dt_ MB"
  at 63; printf '%s' "${C}Network"; at 72; printf '%s\n' "$net"
  printf '%s\n' "    $art3"
  printf '%s' "    $art4"; at 25; printf '%s' "${C}Try"; at 34
  printf '%s\n' "${Y}menu ${D}all programs   ${Y}lynx ${D}web   ${Y}nano ${D}editor   ${Y}ssh ${D}remote login"
  printf '%s' "    $art5"; at 25; printf '%s' "${C}Off"; at 34
  printf '%s\n' "${w}type ${Y}poweroff${w} before switching off"
  printf '%s\n' "    $art6"
else   # 80 columns: one column of facts
  bar $((mt - ma)) $mt; mbar=$v; bar $((st - sf)) $st; sbar=$v; bar $du $dt; dbar=$v
  printf '%s' "    $art0"; at 25; printf '%s' "${C}Host"; at 34; printf '%s\n' "$G$host"
  printf '%s' "    $art1"; at 25; printf '%s' "$when"; at 34; printf '%s\n' "$whenv"
  printf '%s' "    $art2"; at 25; printf '%s' "$mem"; at 34; printf '%s\n' "$mbar  $W$mu ${w}of $mt_ MB"
  printf '%s' "    $art3"; at 25; printf '%s' "$swap"; at 34; printf '%s\n' "$sbar  $W$su ${w}of $st_ MB"
  printf '%s' "    $art4"; at 25; printf '%s' "$disk"; at 34; printf '%s\n' "$dbar  $W$du_ ${w}of $dt_ MB"
  printf '%s' "    $art5"; at 25; printf '%s' "${C}Network"; at 34; printf '%s\n' "$net"
  printf '%s' "    $art6"; at 25; printf '%s' "${C}Try"; at 34; printf '%s\n' "${Y}menu lynx nano ssh ${D}· ${Y}poweroff ${D}to switch off"
fi
rule "$cols"
printf '%s%s%s\n\n' "$D" "$v" "$N"
