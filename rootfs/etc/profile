export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PS1='\h:\w\$ '
# colours for ls on the graphics console (and over SSH): directories, programs and links apart at a glance
alias ls='ls --color=auto'
# lynx's temporary files on the disk: a download is kept there whole before it is saved, and /tmp (2 MB in memory)
# cut bigger ones short
export LYNX_TEMP_SPACE=/var/tmp
# An SSH login: Sprig's card, as at the end of startup, as wide as the terminal (stty). In a subshell, so that its
# variables stay out of this shell; stty and the card's df make it ~0.3 s.
if [ -n "$SSH_CONNECTION" ] && [ -t 1 ]; then
  sz=$(stty size 2>/dev/null)
  (COLUMNS=${sz#* } && . /usr/share/sprig/banner)
  unset sz
fi
