# Linux for tiny386 (a 586 PC: VGA text, PS/2, legacy IDE, ISA NE2000 at 0x300 irq 9, CMOS RTC, x87), on top of
# `make ARCH=i386 tinyconfig`
CONFIG_M586TSC=y
CONFIG_NOHIGHMEM=y
CONFIG_PREEMPT_NONE=y
# compiled for speed, not size (on the Tab5 PC: 60 starts of /bin/true 8.1 -> 6.0 s, printing to the graphics
# console 15% faster; the kernel 2.9 MB instead of 2.2)
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_KERNEL_GZIP=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_EARLY_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_AIO=n
CONFIG_ADVISE_SYSCALLS=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_SYSVIPC=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SWAP=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_UNIX98_PTYS=y
# (the old-style ptys: 512 devices made at boot, 10 s on the Tab5 PC)
CONFIG_LEGACY_PTYS=n
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=n
CONFIG_PATA_LEGACY=y
# ext4 (journal: the emulated PC is often reset or switched off while running), for ext2/3 too
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=n
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_ISA=y
CONFIG_NET_VENDOR_8390=y
CONFIG_NE2000=y
# nothing a tiny386 PC has: CPU vendors' extras, performance counters, microcode, verbose debugging; small log
CONFIG_EXPERT=y
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=n
CONFIG_CPU_SUP_AMD=n
CONFIG_CPU_SUP_HYGON=n
CONFIG_CPU_SUP_CENTAUR=n
CONFIG_CPU_SUP_ZHAOXIN=n
CONFIG_CPU_SUP_CYRIX_32=n
CONFIG_CPU_SUP_TRANSMETA_32=n
CONFIG_CPU_SUP_UMC_32=n
CONFIG_CPU_SUP_VORTEX_32=n
CONFIG_PERF_EVENTS=n
CONFIG_MICROCODE=n
CONFIG_BPF=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_BUGVERBOSE=n
CONFIG_LOG_BUF_SHIFT=13
CONFIG_KALLSYMS=n
# load at 1 MB (tinyconfig says 16 MB: past the end of a small guest)
CONFIG_PHYSICAL_START=0x100000
CONFIG_PHYSICAL_ALIGN=0x100000
# musl on i386 uses the 32-bit time system calls (sigtimedwait etc.: without them BusyBox's init spins)
CONFIG_COMPAT_32BIT_TIME=y
# fewer timer interrupts (each one is costly to emulate), none when idle
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
