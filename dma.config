# PCI and a PCI IDE driver with bus-master DMA: on a Tab5 firmware whose emulated PIIX3 IDE controller has its bus
# master, the disk's sectors move by DMA, one interrupt a command, instead of PIO a sector at a time. ata_generic
# (all_generic_ide: any PCI IDE controller) uses DMA where the bus master says the drive can (its status bits 5-6),
# else PIO on the legacy ports. On a firmware without the bus master the controller isn't enabled, ata_generic leaves
# it and pata_legacy (all: beside a PCI IDE controller too) takes the disk with PIO, as before. (ata_piix needs the
# PIIX's decode bits, which no BIOS sets here, and holds the ports even when it finds the channels disabled.)
CONFIG_PCI=y
CONFIG_PCI_GODIRECT=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_GENERIC=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="ata_generic.all_generic_ide=1 pata_legacy.all=1"
