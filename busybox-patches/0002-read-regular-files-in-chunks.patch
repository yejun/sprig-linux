+	/* A regular file, without -n or -t: read in chunks, and give back what wasn't used (as bash does), instead of
+	 * a poll and a read for every byte (it never blocks: nothing to interrupt) */
+	struct stat st;
+	char chunk[256];
+	int chunked, clen = 0, cpos = 0;
 
 	errno = err = 0;
 
