 /*********************************************************************
  * This void is the core of HTBTree.c . It will
  *       1/ add a new element to the tree at the right place
- *		so that the tree remains sorted
+ *		so that the tree remains sorted (an element equal to one
+ *		already there goes after it)
  *       2/ balance the tree to be as fast as possible when reading it
+ *		(an AVL tree: the depths of an element's two sides differ by
+ *		one at most; the earlier balancing gave up after seven
+ *		corrections, and a page's anchors, added in the order of the
+ *		page, could take 60 comparisons each to find)
  */
+#define BT_DEPTH(e) ((e) ? 1 + MAXIMUM((e)->left_depth, (e)->right_depth) : 0)	/* (e: no side effects) */
+
+/* Put the element on the side "left" (or the right) of "e" in its place,
+ * with e below it on the other side; returns it.
+ */
+static HTBTElement *HTBTree_rotate(HTBTree *tree, HTBTElement *e, int left)
+{
+    HTBTElement *c = left ? e->left : e->right;
+    HTBTElement *inner = left ? c->right : c->left;
+
+    if (left) {
+	e->left = inner;
+	e->left_depth = BT_DEPTH(inner);
+	c->right = e;
+    } else {
+	e->right = inner;
+	e->right_depth = BT_DEPTH(inner);
+	c->left = e;
+    }
+    if (inner != NULL)
+	inner->up = e;
+    c->up = e->up;
+    if (e->up == NULL)
+	tree->top = c;
+    else if (e->up->left == e)
+	e->up->left = c;
+    else
+	e->up->right = c;
+    e->up = c;
+    if (left)
+	c->right_depth = BT_DEPTH(e);
+    else
+	c->left_depth = BT_DEPTH(e);
+    return c;
+}
