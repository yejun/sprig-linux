#!/bin/bash
# The C compiler for the guest: zig cc for i386 Linux with musl, Pentium instructions. Leaves out the GNU ld options
# zig's linker doesn't take, and passes -Wl,<file>.o on as that object (BusyBox's CONFIG_EXTRA_LDLIBS: build.sh).
args=()
for a in "$@"; do
  case "$a" in
    -Wl,--warn-common|-Wl,-Map,*|-Wl,--sort-common|-Wl,--sort-section,alignment|-Wl,--verbose) ;;
    -Wl,*.o) args+=("${a#-Wl,}") ;;
    *) args+=("$a") ;;
  esac
done
# ZCC_LINK_O2=1: a link (no -c, -S, -E) at -O2, so that zig builds its libc and compiler-rt for speed, not size (they
# take the link's -O: for size they copy, fill and measure strings a byte at a time); the objects keep theirs
if [[ "${ZCC_LINK_O2:-}" == 1 ]]; then
  link=1
  for a in "${args[@]}"; do case "$a" in -c|-S|-E) link=0 ;; esac; done
  if [[ $link == 1 ]]; then
    for i in "${!args[@]}"; do case "${args[$i]}" in -Os|-Oz|-O1|-O0) args[$i]=-O2 ;; esac; done
  fi
fi
exec zig cc -target x86-linux-musl -mcpu=pentium "${args[@]}"
