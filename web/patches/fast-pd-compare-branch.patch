+/* Consume a following JNE, JAE or JE while the CMP/TEST operands and result are still available.
+ * Read the live handler so a rewritten instruction or a block cut by pd_wrote follows normal dispatch.
+ * The first decrement accounts for the compare. PD_JUMP or PD_NEXT accounts for the branch. */
+#if defined(__wasm__) && !defined(FAST_VERIFY)
+#define PD_COMPARE_NEXT(carry) do { \
+	--steps; \
+	pu++; \
+	const void *next = pu->h; \
+	if (next == &&pd_j32_5) { /* JNE */ \
+		if (cpu->cc.dst != 0) PD_JUMP(PD_REL32); \
+	} else if (next == &&pd_j32_3) { /* JAE */ \
+		if (!(carry)) PD_JUMP(PD_REL32); \
+	} else if (next == &&pd_j32_4) { /* JE */ \
+		if (cpu->cc.dst == 0) PD_JUMP(PD_REL32); \
+	} else { \
+		goto *next; \
+	} \
+	PD_NEXT; \
+} while (0)
+#else
+#define PD_COMPARE_NEXT(carry) PD_NEXT
+#endif
+#define PD_ALU1(N, SFX, SZ, OP, LR, SR, LM, SM, T, WR, AFTER) \
+pd_##N##_rr##SFX: { PD_BEGIN; int _a = pu->rm, _b = pu->r; OP(_a, _b, LR, SR, LR, SR) AFTER; } \
+pd_##N##_rm##SFX: { PD_BEGIN; PD_MEM(p, SZ, 0); int _a = pu->r; OP(_a, p, LR, SR, LM, SM) AFTER; } \
+pd_##N##_mr##SFX: { PD_BEGIN; PD_MEM(p, SZ, WR); int _b = pu->r; OP(p, _b, LM, SM, LR, SR) AFTER; } \
+pd_##N##_ri##SFX: { PD_BEGIN; int _a = pu->rm; T _i = pu->i; OP(_a, _i, LR, SR, limm, 0) AFTER; } \
+pd_##N##_mi##SFX: { PD_BEGIN; PD_MEM(p, SZ, WR); T _i = pu->i; OP(p, _i, LM, SM, limm, 0) AFTER; }
+#define PD_ALU(N, OPb, OPw, OPd, WR, AFTER) \
+	PD_ALU1(N, b, 1, OPb, fr8, fw8, fm8, fs8, u8, WR, AFTER) \
+	PD_ALU1(N, w, 2, OPw, lreg16, sreg16, fm16, fs16, u16, WR, AFTER) \
+	PD_ALU1(N, d, 4, OPd, lreg32, sreg32, fm32, fs32, u32, WR, AFTER)
+	PD_ALU(add, ADDb, ADDw, ADDd, 1, PD_NEXT)
+	PD_ALU(or, ORb, ORw, ORd, 1, PD_NEXT)
+	PD_ALU(adc, ADCb, ADCw, ADCd, 1, PD_NEXT)
+	PD_ALU(sbb, SBBb, SBBw, SBBd, 1, PD_NEXT)
+	PD_ALU(and, ANDb, ANDw, ANDd, 1, PD_NEXT)
+	PD_ALU(sub, SUBb, SUBw, SUBd, 1, PD_NEXT)
+	PD_ALU(xor, XORb, XORw, XORd, 1, PD_NEXT)
+	PD_ALU(cmp, FCMPb, FCMPw, FCMPd, 0, PD_COMPARE_NEXT(cpu->cc.src1 < cpu->cc.src2))
+	PD_ALU(test, FTESTb, FTESTw, FTESTd, 0, PD_COMPARE_NEXT(0))
+
