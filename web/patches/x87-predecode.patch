+/* FLD, FST and FSTP on eight bytes already validated as ordinary Wasm guest RAM. */
+void fpu_move_real64(FPU *fpu, int group, void *p)
+{
+	double value;
+	if (group == 0) {
+		__builtin_memcpy(&value, p, sizeof(value));
+		fppush(fpu, value);
+	} else {
+		value = fpget(fpu, 0);
+		__builtin_memcpy(p, &value, sizeof(value));
+		if (group == 3)
+			fppop(fpu);
+	}
+}
